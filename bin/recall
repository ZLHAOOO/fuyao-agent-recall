#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
recall — Agent Recall Engine（BM25 评分，自动唤起联想）

原理：对 memory/+knowledge-base/+workspace/ 建 BM25 倒排索引；
从用户输入提词后按 BM25 打分排序，top 5 注入上下文。
零 API 调用，<100ms，零 token。
"""

# BM25 参数（业界标准值）
K1 = 1.5; B = 0.75
FIELDS = ("w_title", "w_tag", "w_body")
FIELD_BOOST = {"w_title": 3.0, "w_tag": 2.0, "w_body": 1.0}

import os, re, sys, json, argparse, hashlib, math
from collections import defaultdict, Counter

def detect_base():
    """自动检测 Agent 工作目录。

    支持的 Agent 目录结构：
      pi:            ~/.pi/agent/       (MEMORY.md, memory/, knowledge-base/, workspace/)
      OpenClaw:      ~/.openclaw/workspace/ (AGENTS.md, SOUL.md, USER.md, MEMORY.md)
      Hermes:        当前目录 + .hermes.md / AGENTS.md / MEMORY.md
      Claude Code:   当前目录 + CLAUDE.md
      Cursor:        当前目录 + .cursor/rules/

    检测逻辑：找同时包含 AGENTS.md 和 memory/ 或 MEMORY.md 的目录。
    """
    # 常见 Agent 根目录候选
    candidates = [
        os.path.expanduser("~/.pi/agent"),
        os.path.expanduser("~/.openclaw/workspace"),
        os.path.expanduser("~/.agent"),
        os.path.expanduser("~/agent"),
        os.path.expanduser("~/workspace"),
        os.getcwd(),
    ]
    # 有 AGENTS.md + (memory/ 或 MEMORY.md) → 大概率是 Agent 目录
    for c in candidates:
        if not os.path.isdir(c):
            continue
        agents = os.path.join(c, "AGENTS.md")
        memory_dir = os.path.join(c, "memory")
        memory_file = os.path.join(c, "MEMORY.md")
        if os.path.isfile(agents) and (os.path.isdir(memory_dir) or os.path.isfile(memory_file)):
            return c
    # 退而求其次：有 memory/ 或 MEMORY.md 的目录
    for c in candidates:
        if not os.path.isdir(c):
            continue
        if os.path.isdir(os.path.join(c, "memory")) or os.path.isfile(os.path.join(c, "MEMORY.md")):
            return c
    return os.getcwd()

BASE = detect_base()
IDX = os.path.join(BASE, "memory", ".recall-index.json")
# 自动扫描以下目录（存在才扫）；权重：核心记忆 > 知识库 > 工作区
SCAN_CANDIDATES = [
    ("memory", 1.3),
    ("knowledge-base", 0.95),
    ("workspace", 0.85),
    ("notes", 1.0),
    ("docs", 0.9),
]

def scan_dirs():
    """只返回实际存在的目录"""
    return [(d, w) for d, w in SCAN_CANDIDATES if os.path.isdir(os.path.join(BASE, d))]
SKIP_DIRS = {".git", "node_modules", "__pycache__", "sessions", "raw", ".venv"}
SKIP_FILES = {
    ".recall-index.json",
    # Agent 系统每轮必读文件（全量加载进上下文，无需 recall 再次提示）
    "MEMORY.md", "AGENTS.md", "SOUL.md", "USER.md", "IDENTITY.md",
    "TOOLS.md", "HEARTBEAT.md", "CLAUDE.md", "CLAUDE.local.md",
    ".hermes.md", "HERMES.md", ".cursorrules", "README.md",  # 入口/配置文件
}
# 停用词：太通用的词匹配上等于噪音
STOP = set("""的 了 是 我 你 他 她 它 们 这 那 有 在 和 与 就 也 都 而 及 或 一个 一种 什么 怎么
怎样 为什么 可以 能够 需要 应该 如果 但是 所以 因为 然后 还是 就是 其实 感觉 觉得 东西 事情 时候
方式 方法 问题 内容 情况 之后 之前 现在 目前 已经 可能 大概 比如 例如 以及 关于 对于 通过 进行
有没 没有 有没有 有什 什么 有什么 怎么办 是不 不是 是不是 我看 看看 我们 我们的 们的 你们 一下
一些 这个 那个 这些 那些 哪些 哪个 如何 是否 能不 能不能 要不 要不要 可不 帮我 帮忙 一起 一直
最近 现在 今天 明天 昨天 时间 一点 有点 大家 别人 自己 咱们 到底 其他 另外 还有 只是 而且
the a an and or but for with this that what how why can could would should need
if then so because also very just really some any all one two get make use used
have has had does did doing about from into your our their there here when where
""".split())
MIN_LEN = 2
TOP_N = 5


def iter_files():
    for sub, w in scan_dirs():
        root = os.path.join(BASE, sub)
        if not os.path.isdir(root):
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            for fn in filenames:
                if not fn.endswith((".md", ".txt")) or fn in SKIP_FILES:
                    continue
                yield os.path.join(dirpath, fn), w


def tokens(text, keep_stop=False):
    """抽候选词：中文 2-4 gram + 英文/代码标识符。故意粗糙，宁多勿漏。"""
    out = set()
    for w in re.findall(r"[A-Za-z][A-Za-z0-9_.-]{1,}", text):
        lw = w.lower()
        if len(lw) >= 2 and (keep_stop or lw not in STOP):
            out.add(lw)
    for run in re.findall(r"[\u4e00-\u9fff]{3,}", text):
        for n in (3, 4):
            for i in range(len(run) - n + 1):
                g = run[i:i + n]
                if keep_stop or g not in STOP:
                    out.add(g)
    return out


def summarize(path):
    """抽一个文件的：标题、标签、正文词频（Counter）"""
    try:
        with open(path, encoding="utf-8", errors="ignore") as f:
            raw = f.read(20000)
    except OSError:
        return None
    lines = raw.splitlines()
    title = ""
    for ln in lines[:15]:
        m = re.match(r"^#\s+(.+)", ln.strip())
        if m:
            title = m.group(1).strip()
            break
    if not title:
        title = os.path.splitext(os.path.basename(path))[0]
    tags = re.findall(r"#([\w\u4e00-\u9fff]{2,})", raw)
    # gist：首段有意义的文字 + 标签（标题单独显示，不重复）
    gist_parts = []
    for ln in lines[1:40]:
        ln2 = ln.strip()
        if ln2 and not ln2.startswith(("#", ">", "-", "*", "|", "`", "!")) and len(ln2) > 8:
            # 如果首段文字就是标题的重复，跳过
            if title and ln2.lower().startswith(title.lower()[:15]):
                continue
            gist_parts.append(ln2[:60])
            break
    if not gist_parts and title:
        gist_parts.append(title[:50])
    if tags:
        gist_parts.append("#" + " #".join(tags[:3]))
    gist = " | ".join(gist_parts)[:100]
    heads = " ".join(re.findall(r"^#{1,3}\s+(.+)$", raw, re.M)[:25])
    fname = os.path.basename(path)
    return {
        "path": os.path.relpath(path, BASE),
        "title": title[:70],
        "gist": gist,
        "w_title": Counter(tokens(title + " " + fname + " " + heads)),
        "w_tag": Counter(t.lower() for t in tags),
        "w_body": Counter(tokens(raw[:8000])),
    }


def cmd_build(a, quiet=False):
    docs, n = [], 0
    for p, w in iter_files():
        d = summarize(p)
        if d:
            d["weight"] = w
            docs.append(d)
            n += 1
    # 倒排索引：词 → [(doc_idx, field_key, tf)]
    inv = defaultdict(list)
    for i, d in enumerate(docs):
        for fld in FIELDS:
            for w, cnt in d[fld].items():
                inv[w].append([i, fld, cnt])
    # 修：中文 2-gram 若在 >25% 文件里出现 → 视为停用，从索引里剔除
    df = defaultdict(int)
    for w, posts in inv.items():
        if re.match(r"^[\u4e00-鿿]{2}$", w) and len({p[0] for p in posts}) > max(3, len(docs) * 0.25):
            df[w] = len({p[0] for p in posts})
    if df:
        inv = {w: posts for w, posts in inv.items() if w not in df}
    # 文档每段长度（用于 BM25 长度归一化）
    dl = {str(i): {fld: len(d[fld]) for fld in FIELDS} for i, d in enumerate(docs)}
    avgdl = {fld: (sum(dl[str(i)][fld] for i in range(len(docs))) / max(1, len(docs))) for fld in FIELDS}
    stats = {"n": len(docs), "avgdl": avgdl}
    slim = [{k: v for k, v in d.items() if not k.startswith("w_")} for d in docs]
    with open(IDX, "w", encoding="utf-8") as f:
        json.dump({"docs": slim, "inv": inv, "dl": dl, "stats": stats, "fp": fingerprint()}, f, ensure_ascii=False)
    if not quiet:
        size = os.path.getsize(IDX) / 1024
        print(f"✓ 索引已建：{n} 个文件 / {len(inv)} 个词 / {size:.0f}KB → {os.path.relpath(IDX, BASE)}")


def fingerprint():
    """轻量指纹：文件数 + 最新 mtime。用于检测索引是否过期（<20ms）"""
    n, newest = 0, 0.0
    for p, _ in iter_files():
        try:
            m = os.path.getmtime(p)
        except OSError:
            continue
        n += 1
        if m > newest:
            newest = m
    return f"{n}:{newest:.0f}"


def load_idx():
    if not os.path.exists(IDX):
        return None
    try:
        with open(IDX, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None




def recall(text, top=TOP_N, auto=True):
    """BM25 评分的本地联想"""
    idx = load_idx()
    if auto and (not idx or idx.get("fp") != fingerprint()):
        try:
            cmd_build(None, quiet=True)
            idx = load_idx()
        except Exception:
            pass
    if not idx:
        return []

    inv, docs = idx["inv"], idx["docs"]
    N = idx["stats"]["n"]
    avgdl = idx["stats"]["avgdl"]
    dl = idx["dl"]

    q_terms = tokens(text)
    if not q_terms:
        return []

    # 每个文档的 BM25 累积分
    score = defaultdict(float)
    hits = defaultdict(set)

    for t in q_terms:
        posts = inv.get(t)
        if not posts:
            continue
        # BM25 IDF：log((N - n + 0.5) / (n + 0.5) + 1)
        n = len({p[0] for p in posts})
        idf = math.log((N - n + 0.5) / (n + 0.5) + 1.0)
        # 英文标识符提权（"Tiptap"这种词信息量大）
        is_cjk = bool(re.match(r"^[\u4e00-\u9fff]+$", t))
        term_boost = 2.5 if not is_cjk else (1.0 + max(0, len(t) - 3) * 0.4)

        for i, fld, tf in posts:
            # BM25 分子：tf * (k1 + 1) / (tf + k1 * (1 - b + b * dl/avgdl))
            dlen = dl[str(i)][fld] if str(i) in dl and fld in dl[str(i)] else 1
            norm = 1 - B + B * (dlen / max(0.5, avgdl[fld]))
            bm25 = idf * (tf * (K1 + 1)) / (tf + K1 * norm)
            score[i] += bm25 * FIELD_BOOST[fld] * term_boost
            if fld in ("w_title", "w_tag"):
                hits[i].add(t)

    if not score:
        return []

    ranked = sorted(score.items(), key=lambda x: -x[1])
    best = max(r[1] for r in ranked)

    out = []
    for i, sc in ranked[:top]:
        if sc < max(0.15, best * 0.25):
            break
        if not hits[i] and sc < best * 0.60:
            continue
        d = docs[i]
        out.append({"path": d["path"], "title": d["title"], "gist": d["gist"],
                    "score": round(sc, 3), "why": sorted(hits[i])[:3]})
    return out


def cmd_query(a):
    res = recall(a.text, a.top)
    if a.json:
        print(json.dumps(res, ensure_ascii=False, indent=1))
        return
    if not res:
        return          # 没联想到 → 完全沉默
    lines = ["🧠 你的库里可能有相关的（未读取，需要才读）："]
    for r in res:
        why = ("/".join(r["why"]))[:24]
        gist = r.get("gist", "")
        head = f"· {r['title']}"
        if gist and gist != r['title']:
            head += f" — {gist}"
        if why:
            head += f"  ←{why}"
        lines.append(head)
    txt = "\n".join(lines)
    print(txt[:300])


def cmd_stats(a):
    idx = load_idx()
    if not idx:
        print("✗ 索引不存在，先跑 recall build"); return
    print(f"文件 {len(idx['docs'])} / 词 {len(idx['inv'])} / "
          f"{os.path.getsize(IDX)/1024:.0f}KB")
    for d in idx["docs"][:100]:
        print(f"  {d['path']}")


def main():
    ap = argparse.ArgumentParser(prog="recall")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("build").set_defaults(fn=cmd_build)
    sub.add_parser("stats").set_defaults(fn=cmd_stats)
    p = sub.add_parser("q")
    p.add_argument("text"); p.add_argument("--top", type=int, default=TOP_N)
    p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_query)
    argv = sys.argv[1:]
    if argv and argv[0] not in ("build", "stats", "q", "-h", "--help"):
        argv = ["q"] + argv          # 允许 recall "问题"
    a = ap.parse_args(argv)
    if not getattr(a, "cmd", None):
        ap.print_help(); return
    a.fn(a)


if __name__ == "__main__":
    main()
