#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
recall — Agent Recall Engine（BM25 评分，自动唤起联想）

原理：对 memory/+knowledge-base/+workspace/ 建 BM25 倒排索引；
从用户输入提词后按 BM25 打分排序，top 5 注入上下文。
零 API 调用，<100ms，零 token。
"""

# BM25 参数（业界标准值）
K1 = 1.5; B = 0.75
FIELDS = ("w_title", "w_tag", "w_body")
FIELD_BOOST = {"w_title": 3.0, "w_tag": 2.0, "w_body": 1.0}

import os, re, sys, json, argparse, hashlib, math, pickle, sqlite3
from collections import defaultdict, Counter

def detect_base():
    """自动检测 Agent 工作目录。

    支持的 Agent 目录结构：
      pi:            ~/.pi/agent/       (MEMORY.md, memory/, knowledge-base/, workspace/)
      OpenClaw:      ~/.openclaw/workspace/ (AGENTS.md, SOUL.md, USER.md, MEMORY.md)
      Hermes:        当前目录 + .hermes.md / AGENTS.md / MEMORY.md
      Claude Code:   当前目录 + CLAUDE.md
      Cursor:        当前目录 + .cursor/rules/

    检测逻辑：找同时包含 AGENTS.md 和 memory/ 或 MEMORY.md 的目录。
    """
    # 常见 Agent 根目录候选
    candidates = [
        os.path.expanduser("~/.pi/agent"),
        os.path.expanduser("~/.openclaw/workspace"),
        os.path.expanduser("~/.agent"),
        os.path.expanduser("~/agent"),
        os.path.expanduser("~/workspace"),
        os.getcwd(),
    ]
    # 有 AGENTS.md + (memory/ 或 MEMORY.md) → 大概率是 Agent 目录
    for c in candidates:
        if not os.path.isdir(c):
            continue
        agents = os.path.join(c, "AGENTS.md")
        memory_dir = os.path.join(c, "memory")
        memory_file = os.path.join(c, "MEMORY.md")
        if os.path.isfile(agents) and (os.path.isdir(memory_dir) or os.path.isfile(memory_file)):
            return c
    # 退而求其次：有 memory/ 或 MEMORY.md 的目录
    for c in candidates:
        if not os.path.isdir(c):
            continue
        if os.path.isdir(os.path.join(c, "memory")) or os.path.isfile(os.path.join(c, "MEMORY.md")):
            return c
    return os.getcwd()

BASE = detect_base()
DB = os.path.join(BASE, "memory", ".recall-index.db")   # SQLite：查询按词点查，不整体加载
# 自动扫描以下目录（存在才扫）；权重：核心记忆 > 知识库 > 工作区
SCAN_CANDIDATES = [
    ("memory", 1.3),
    ("knowledge-base", 0.95),
    ("workspace", 0.85),
    ("notes", 1.0),
    ("docs", 0.9),
    ("skills", 1.0),  # 2026-09-10 补：技能库存进联想半径（此前 fuyao 系 skill 联想不到，盲区）
]

def scan_dirs():
    """只返回实际存在的目录"""
    return [(d, w) for d, w in SCAN_CANDIDATES if os.path.isdir(os.path.join(BASE, d))]
SKIP_DIRS = {".git", "node_modules", "__pycache__", "sessions", "raw", ".venv"}
SKIP_FILES = {
    ".recall-index.json",
    # Agent 系统每轮必读文件（全量加载进上下文，无需 recall 再次提示）
    "MEMORY.md", "AGENTS.md", "SOUL.md", "USER.md", "IDENTITY.md",
    "TOOLS.md", "HEARTBEAT.md", "CLAUDE.md", "CLAUDE.local.md",
    ".hermes.md", "HERMES.md", ".cursorrules", "README.md",  # 入口/配置文件
}
# 停用词：太通用的词匹配上等于噪音
STOP = set("""的 了 是 我 你 他 她 它 们 这 那 有 在 和 与 就 也 都 而 及 或 一个 一种 什么 怎么
怎样 为什么 可以 能够 需要 应该 如果 但是 所以 因为 然后 还是 就是 其实 感觉 觉得 东西 事情 时候
方式 方法 问题 内容 情况 之后 之前 现在 目前 已经 可能 大概 比如 例如 以及 关于 对于 通过 进行
